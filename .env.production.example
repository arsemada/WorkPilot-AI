# Copy to a secret store or a gitignored file before a real deployment.
# Do not commit real passwords or API keys.

POSTGRES_DB=workpilot_db
POSTGRES_USER=workpilot
POSTGRES_PASSWORD=replace-with-a-long-random-password

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/workpilot_db
SPRING_DATASOURCE_USERNAME=workpilot
SPRING_DATASOURCE_PASSWORD=replace-with-a-long-random-password

# Public browser origin. Required by docker-compose.prod.yml.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Baked into the frontend image at build time. Rebuild after changing it.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
API_BASE_URL=http://backend:8081

SESSION_COOKIE_SECURE=true
SPRING_PROFILES_ACTIVE=prod

# Optional. Leave empty and the assistant reports that it is not configured.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT=30s
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_MODEL_VERSION=3
# EMBEDDING_DIMENSIONS=1536
