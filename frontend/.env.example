# Browser-side requests must use an address the user's browser can reach.
# This value is embedded in the client bundle. Do not put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081

# Server-side requests from the Next.js process.
# Use http://localhost:8081 when Next.js runs on the host.
# Docker Compose overrides this to http://backend:8081.
# Session calls from the browser keep using NEXT_PUBLIC_API_BASE_URL.
API_BASE_URL=http://localhost:8081
