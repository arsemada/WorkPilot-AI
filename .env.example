# PostgreSQL
# Host port 5434 avoids the local PostgreSQL already listening on 5432
# and the existing Docker database published on 5433.
POSTGRES_DB=workpilot_db
POSTGRES_USER=workpilot
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Backend process running on the host.
# Docker Compose overrides the JDBC URL to jdbc:postgresql://postgres:5432/workpilot_db.
SERVER_PORT=8081
BACKEND_PORT=8081
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/workpilot_db
SPRING_DATASOURCE_USERNAME=workpilot
SPRING_DATASOURCE_PASSWORD=change-me
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# SESSION_COOKIE_SECURE=false

# Frontend
# NEXT_PUBLIC_API_BASE_URL is used by browser code and is baked in at build time.
# API_BASE_URL is for server-side code. Compose sets it to http://backend:8081.
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
API_BASE_URL=http://localhost:8081

# Assistant provider. The backend reads these. Leave the key empty until you have one.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT=30s
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_MODEL_VERSION=3
# EMBEDDING_DIMENSIONS=1536
