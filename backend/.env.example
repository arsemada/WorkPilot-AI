# Local backend configuration. Copy to backend/.env before running Maven on the host.
# Docker Compose does not use this file; it injects service environment variables itself.

SERVER_PORT=8081
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/workpilot_db
SPRING_DATASOURCE_USERNAME=workpilot
SPRING_DATASOURCE_PASSWORD=change-me

# Comma-separated browser origins allowed to call the API with cookies.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set to true only when the site is served over HTTPS.
# SESSION_COOKIE_SECURE=false
